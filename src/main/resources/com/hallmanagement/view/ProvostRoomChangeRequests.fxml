<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hallmanagement.controller.ProvostRoomChangeRequestsController"
            styleClass="dashboard-root"
            stylesheets="@../css/dashboard.css"
            minWidth="960" minHeight="640">

    <left>
        <VBox styleClass="sidebar" prefWidth="250" spacing="0">
            <VBox styleClass="sidebar-header" spacing="4">
                <Label styleClass="sidebar-app-name" text="RUET Hall System" />
                <Label styleClass="sidebar-portal"   text="PROVOST PORTAL" />
            </VBox>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-width: 0;" VBox.vgrow="ALWAYS">
                <VBox styleClass="sidebar-nav" spacing="3">
                    <Label styleClass="nav-section-label" text="ADMINISTRATION" />
                    <Button styleClass="nav-button" text="🏠  Dashboard" onAction="#onDashboardClicked" />
                    <Button styleClass="nav-button" text="👤  Provost Profile" onAction="#onProfileClicked" />
                    <Button styleClass="nav-button" text="🏢  Hall Information" onAction="#onHallInformationClicked" />
                    <Button fx:id="btnNavPaymentRequests" styleClass="nav-button" text="💳  Payment Requests" onAction="#onPaymentRequestsClicked" />
                    <Button fx:id="btnNavNoticeBoard" styleClass="nav-button" text="📢  Notice Board" onAction="#onNoticeBoardClicked" />

                    <Region prefHeight="10" />

                    <Label styleClass="nav-section-label" text="RESIDENCE MANAGEMENT" />
                    <Button fx:id="btnNavHallChangeRequests" styleClass="nav-button" text="🔄  Hall Transfers" onAction="#onHallChangeRequestsClicked" />
                    <Button fx:id="btnNavRoomChangeRequests" styleClass="nav-button-active" text="🛏  Room/Seat Changes" />
                    <Button fx:id="btnNavComplaints" styleClass="nav-button" text="📝  Complaints" onAction="#onComplaintsClicked" />
                    <Button fx:id="btnNavHallLeaveRequests" styleClass="nav-button" text="🚪  Hall Leave Requests" onAction="#onHallLeaveRequestsClicked" />
                </VBox>
            </ScrollPane>

            <VBox styleClass="sidebar-footer" alignment="BOTTOM_CENTER">
                <Label fx:id="lblSidebarUser" styleClass="sidebar-footer-text" />
                <Label fx:id="lblSidebarRole" styleClass="sidebar-footer-text" />
                <Region prefHeight="6" />
                <Button fx:id="btnLogout"
                        styleClass="btn-logout"
                        text="⏻  Sign Out"
                        maxWidth="Infinity"
                        onAction="#onLogoutClicked" />
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="0" VBox.vgrow="ALWAYS">

            <HBox styleClass="top-header-bar">
                <Button text="← Back" styleClass="btn-top-back" onAction="#onBackClicked" />
                <Label styleClass="top-header-title" text="Room &amp; Seat Change Requests" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="🔄 Refresh" styleClass="btn-ghost" onAction="#onRefreshClicked" />
            </HBox>

            <ScrollPane fitToWidth="true" fitToHeight="false" styleClass="main-scroll" VBox.vgrow="ALWAYS">
                <VBox styleClass="main-content-fluid" spacing="18">

                    <HBox styleClass="welcome-hero" alignment="CENTER_LEFT" spacing="18">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="SEAT ALLOCATION DESK" styleClass="welcome-badge" />
                            <Label text="Same-Hall Room &amp; Seat Change Requests" styleClass="welcome-name" />
                            <Label text="Review, verify available seats and dues, approve seat swaps atomically, or reject with feedback." styleClass="welcome-meta" wrapText="true" />
                        </VBox>
                        <HBox spacing="14" alignment="CENTER_RIGHT">
                            <VBox styleClass="stat-subcard" alignment="CENTER" spacing="2">
                                <Label text="Pending" styleClass="section-badge" />
                                <Label fx:id="lblPendingCount" text="0" style="-fx-font-size: 20px; -fx-font-weight: 700; -fx-text-fill: #fbbf24;" />
                            </VBox>
                            <VBox styleClass="stat-subcard" alignment="CENTER" spacing="2">
                                <Label text="Processed" styleClass="section-badge" />
                                <Label fx:id="lblProcessedCount" text="0" style="-fx-font-size: 20px; -fx-font-weight: 700; -fx-text-fill: #4ade80;" />
                            </VBox>
                        </HBox>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <TextField fx:id="txtSearch" promptText="🔍  Search by student name, roll, room number, or request code..."
                                   styleClass="input-field" HBox.hgrow="ALWAYS" onKeyReleased="#onSearchKeyReleased" />
                    </HBox>

                    <VBox fx:id="boxReviewModal" styleClass="card" spacing="14" visible="false" managed="false">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Review Room Change Request" styleClass="card-title" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button text="✕ Close" styleClass="btn-ghost" onAction="#onCloseReviewModalClicked" />
                        </HBox>

                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <Label text="Student:" styleClass="field-label" />
                            <Label fx:id="lblModalStudentName" styleClass="text-value-bold" text="" />
                            <Label text="•" styleClass="text-separator" />
                            <Label fx:id="lblModalStudentId" styleClass="text-highlight" text="" />
                            <Label text="•" styleClass="text-separator" />
                            <Label fx:id="lblModalStudentDept" styleClass="text-value" text="" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label text="Status:" styleClass="field-label" />
                            <Label fx:id="lblModalStatus" text="" />
                        </HBox>

                        <GridPane hgap="16" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints minWidth="140" />
                                <ColumnConstraints hgrow="ALWAYS" />
                            </columnConstraints>
                            <Label text="Current Residence:" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                            <Label fx:id="lblModalCurResidence" styleClass="text-value" text="" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                            <Label text="Requested Target:" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                            <Label fx:id="lblModalReqResidence" styleClass="text-highlight" text="" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                            <Label text="Reason:" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                            <Label fx:id="lblModalReason" styleClass="text-value" text="" wrapText="true" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                            <Label text="Date Submitted:" styleClass="field-label" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                            <Label fx:id="lblModalReqDate" styleClass="text-value" text="" GridPane.rowIndex="3" GridPane.columnIndex="1" />
                        </GridPane>

                        <VBox fx:id="boxModalProcessedInfo" spacing="4" visible="false" managed="false">
                            <HBox spacing="10">
                                <Label text="Processed By:" styleClass="field-label" />
                                <Label fx:id="lblModalProcessedBy" styleClass="text-value" text="" />
                                <Label text="•" styleClass="text-separator" />
                                <Label text="Processed Date:" styleClass="field-label" />
                                <Label fx:id="lblModalProcessedDate" styleClass="text-value" text="" />
                            </HBox>
                        </VBox>

                        <VBox fx:id="boxModalRejectionReason" spacing="4" visible="false" managed="false">
                            <Label text="Rejection Reason:" styleClass="field-label" />
                            <Label fx:id="lblModalRejectionReason" style="-fx-text-fill: #f87171;" text="" wrapText="true" />
                        </VBox>

                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Button fx:id="btnModalReject" text="❌ Reject Request" styleClass="btn-danger" onAction="#onModalRejectClicked" />
                            <Button fx:id="btnModalApprove" text="✓ Approve &amp; Swap Seat" styleClass="btn-primary" onAction="#onModalApproveClicked" />
                        </HBox>
                    </VBox>

                    <VBox fx:id="boxRejectModal" styleClass="card" spacing="14" visible="false" managed="false">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Reject Room Change Request" styleClass="card-title" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button text="✕ Close" styleClass="btn-ghost" onAction="#onCloseRejectModalClicked" />
                        </HBox>

                        <Label fx:id="lblRejectTargetPrompt" text="Please provide the reason for rejection (mandatory for student notification):" styleClass="field-label" />
                        <TextArea fx:id="txtRejectionReason" promptText="Enter detailed administrative rejection reason..." prefRowCount="3" wrapText="true" styleClass="text-area" />

                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Label fx:id="lblRejectFeedback" text="" styleClass="status-error" HBox.hgrow="ALWAYS" wrapText="true" />
                            <Button text="Cancel" styleClass="btn-ghost" onAction="#onCloseRejectModalClicked" />
                            <Button text="Confirm Rejection" styleClass="btn-danger" onAction="#onConfirmRejectClicked" />
                        </HBox>
                    </VBox>

                    <VBox styleClass="card" spacing="12" VBox.vgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="All Same-Hall Room/Seat Change Applications" styleClass="card-title" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblTableSummary" text="Showing 0 request(s)" style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;" />
                        </HBox>

                        <TableView fx:id="tableRequests" minHeight="360" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colSerial" text="Serial" minWidth="60" prefWidth="65" style="-fx-alignment: CENTER;" />
                                <TableColumn fx:id="colDate" text="Date Submitted" minWidth="110" prefWidth="120" style="-fx-alignment: CENTER;" />
                                <TableColumn fx:id="colStudentName" text="Student Name" minWidth="130" prefWidth="150" />
                                <TableColumn fx:id="colRoll" text="Roll" minWidth="80" prefWidth="90" style="-fx-alignment: CENTER;" />
                                <TableColumn fx:id="colDept" text="Dept" minWidth="65" prefWidth="75" style="-fx-alignment: CENTER;" />
                                <TableColumn fx:id="colCurRoom" text="Current Room" minWidth="100" prefWidth="110" style="-fx-alignment: CENTER;" />
                                <TableColumn fx:id="colCurSeat" text="Current Seat" minWidth="90" prefWidth="100" style="-fx-alignment: CENTER;" />
                                <TableColumn fx:id="colReqRoom" text="Target Room" minWidth="100" prefWidth="110" style="-fx-alignment: CENTER;" />
                                <TableColumn fx:id="colReqSeat" text="Target Seat" minWidth="90" prefWidth="100" style="-fx-alignment: CENTER;" />
                                <TableColumn fx:id="colReason" text="Reason" minWidth="150" prefWidth="180" />
                                <TableColumn fx:id="colStatus" text="Status" minWidth="95" prefWidth="105" style="-fx-alignment: CENTER;" />
                                <TableColumn fx:id="colAction" text="Actions" minWidth="110" prefWidth="120" style="-fx-alignment: CENTER;" />
                            </columns>
                            <placeholder>
                                <Label text="No room change requests found." style="-fx-text-fill: #64748b; -fx-font-size: 13px;" />
                            </placeholder>
                        </TableView>
                    </VBox>

                </VBox>
            </ScrollPane>

            <HBox styleClass="status-strip">
                <Label text="●" styleClass="status-dot-active" />
                <Label styleClass="status-strip-text" text="Room Allocation Desk Synchronized · Live DB Connected" />
            </HBox>

            <HBox styleClass="university-footer">
                <Label styleClass="university-footer-text" text="Rajshahi University of Engineering &amp; Technology · Hall Management System · Automated Hall ERP" />
            </HBox>

        </VBox>
    </center>

</BorderPane>
