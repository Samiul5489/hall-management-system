<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hallmanagement.controller.ProvostComplaintsController"
            styleClass="dashboard-root"
            stylesheets="@../css/dashboard.css"
            minWidth="960" minHeight="640">

    <left>
        <VBox styleClass="sidebar" prefWidth="250" spacing="0">
            <VBox styleClass="sidebar-header" spacing="4">
                <Label styleClass="sidebar-app-name" text="RUET Hall System" />
                <Label styleClass="sidebar-portal"   text="PROVOST PORTAL" />
            </VBox>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-width: 0;" VBox.vgrow="ALWAYS">
                <VBox styleClass="sidebar-nav" spacing="3">
                    <Label styleClass="nav-section-label" text="ADMINISTRATION" />
                    <Button fx:id="btnNavDashboard" styleClass="nav-button" text="🏠  Dashboard" onAction="#onDashboardClicked" />
                    <Button fx:id="btnNavProfile"   styleClass="nav-button" text="👤  My Profile" onAction="#onProfileClicked" />
                    <Button fx:id="btnNavHallInfo"  styleClass="nav-button" text="🏢  Hall Information" onAction="#onHallInformationClicked" />
                    <Button fx:id="btnNavPaymentRequests" styleClass="nav-button" text="💳  Payment Requests" onAction="#onPaymentRequestsClicked" />
                    <Button fx:id="btnNavNoticeBoard" styleClass="nav-button" text="📢  Notice Board" onAction="#onNoticeBoardClicked" />

                    <Region prefHeight="10" />

                    <Label styleClass="nav-section-label" text="RESIDENCE MANAGEMENT" />
                    <Button fx:id="btnNavHallChangeRequests" styleClass="nav-button" text="🔄  Hall Transfers" onAction="#onHallChangeRequestsClicked" />
                    <Button fx:id="btnNavRoomChangeRequests" styleClass="nav-button" text="🛏  Room/Seat Changes" onAction="#onRoomChangeRequestsClicked" />
                    <Button fx:id="btnNavComplaints" styleClass="nav-button-active" text="📝  Complaints" />
                    <Button fx:id="btnNavHallLeaveRequests" styleClass="nav-button" text="🚪  Hall Leave Requests" onAction="#onHallLeaveRequestsClicked" />
                </VBox>
            </ScrollPane>

            <VBox styleClass="sidebar-footer" alignment="BOTTOM_CENTER">
                <Label fx:id="lblSidebarUser" styleClass="sidebar-footer-text" />
                <Label fx:id="lblSidebarRole" styleClass="sidebar-footer-text" />
                <Region prefHeight="6" />
                <Button fx:id="btnLogout"
                        styleClass="btn-logout"
                        text="⏻  Sign Out"
                        maxWidth="Infinity"
                        onAction="#onLogoutClicked" />
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="0" VBox.vgrow="ALWAYS">

            <HBox styleClass="top-header-bar">
                <Button text="← Back" styleClass="btn-top-back" onAction="#onBackClicked" />
                <Label styleClass="top-header-title" text="Student Complaints &amp; Grievances" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="🔄 Refresh" styleClass="btn-ghost" onAction="#onRefreshClicked" />
            </HBox>

            <ScrollPane fitToWidth="true" fitToHeight="false" styleClass="main-scroll" VBox.vgrow="ALWAYS">
                <VBox styleClass="main-content-fluid" spacing="18">

                    <HBox styleClass="welcome-hero" alignment="CENTER_LEFT" spacing="18">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="GRIEVANCE RESOLUTION DESK" styleClass="welcome-badge" />
                            <Label text="Student Grievances &amp; Residence Complaints" styleClass="welcome-name" />
                            <Label text="Review, investigate, resolve, and reply to official student residential grievances." styleClass="welcome-meta" wrapText="true" />
                        </VBox>
                    </HBox>

                    <VBox fx:id="boxReviewModal" styleClass="card" spacing="14" visible="false" managed="false">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Review &amp; Process Complaint" styleClass="card-title" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button text="✕ Close" styleClass="btn-ghost" onAction="#onCloseReviewModalClicked" />
                        </HBox>

                        <HBox styleClass="info-context-strip" spacing="14" alignment="CENTER_LEFT">
                            <Label text="Complainant:" styleClass="field-label" />
                            <Label fx:id="lblStudentName" styleClass="text-value-bold" text="Loading..." />
                            <Label text="•" styleClass="text-separator" />
                            <Label fx:id="lblStudentId" styleClass="text-highlight" text="" />
                            <Label text="•" styleClass="text-separator" />
                            <Label fx:id="lblStudentDept" styleClass="text-value" text="" />
                            <Label text="•" styleClass="text-separator" />
                            <Label fx:id="lblStudentResidence" styleClass="text-value" text="" />
                        </HBox>

                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <Label text="Subject:" styleClass="field-label" />
                            <Label fx:id="lblComplaintTitle" styleClass="text-value-bold" text="" wrapText="true" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label text="Status:" styleClass="field-label" />
                            <Label fx:id="lblStatusBadge" text="" />
                            <Label text="•" styleClass="text-separator" />
                            <Label text="Date:" styleClass="field-label" />
                            <Label fx:id="lblSubmittedAt" styleClass="text-value" text="" />
                        </HBox>

                        <VBox spacing="4">
                            <Label text="Complaint Full Details:" styleClass="field-label" />
                            <Label fx:id="lblComplaintMessage" styleClass="text-value" text="" wrapText="true" />
                        </VBox>

                        <VBox fx:id="boxProcessAction" spacing="10">
                            <Label text="Provost Official Response (Max 100 words):" styleClass="field-label" />
                            <TextArea fx:id="txtProvostReply" promptText="Enter response or leave blank for default resolution message..." prefRowCount="3" wrapText="true" styleClass="text-area" />
                            <HBox alignment="CENTER_LEFT">
                                <Label fx:id="lblWordCounter" text="0 / 100 words" styleClass="text-muted" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblFeedback" text="" styleClass="status-error" />
                            </HBox>

                            <HBox alignment="CENTER_RIGHT" spacing="10">
                                <Button text="Cancel" styleClass="btn-ghost" onAction="#onCloseReviewModalClicked" />
                                <Button text="❌ Reject Complaint" styleClass="btn-danger" onAction="#onRejectClicked" />
                                <Button text="✓ Approve (Default Msg)" styleClass="btn-ghost" onAction="#onApproveDefaultClicked" />
                                <Button text="✓ Approve with Custom Msg" styleClass="btn-primary" onAction="#onApproveCustomClicked" />
                            </HBox>
                        </VBox>

                        <VBox fx:id="boxProcessedResponse" spacing="4" visible="false" managed="false" styleClass="form-subcard-highlight">
                            <Label text="Recorded Official Response:" styleClass="section-badge" />
                            <Label fx:id="lblExistingResponse" styleClass="text-value" text="" wrapText="true" />
                            <Label fx:id="lblRespondedAt" styleClass="text-muted" text="" />
                        </VBox>
                    </VBox>

                    <VBox styleClass="card" spacing="12" VBox.vgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Assigned Student Complaints" styleClass="card-title" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblComplaintCount" text="0 total complaints" style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;" />
                        </HBox>

                        <TableView fx:id="tblComplaints" minHeight="360" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colSerial" text="Serial" minWidth="60" prefWidth="65" style="-fx-alignment: CENTER;" />
                                <TableColumn fx:id="colDate" text="Date Filed" minWidth="110" prefWidth="120" style="-fx-alignment: CENTER;" />
                                <TableColumn fx:id="colStudentName" text="Student Name" minWidth="130" prefWidth="150" />
                                <TableColumn fx:id="colStudentId" text="Roll" minWidth="80" prefWidth="90" style="-fx-alignment: CENTER;" />
                                <TableColumn fx:id="colResidence" text="Room/Seat" minWidth="90" prefWidth="105" style="-fx-alignment: CENTER;" />
                                <TableColumn fx:id="colTitle" text="Complaint Title" minWidth="180" prefWidth="230" />
                                <TableColumn fx:id="colStatus" text="Status" minWidth="95" prefWidth="105" style="-fx-alignment: CENTER;" />
                                <TableColumn fx:id="colActions" text="Actions" minWidth="140" prefWidth="160" style="-fx-alignment: CENTER;" />
                            </columns>
                            <placeholder>
                                <Label text="No complaints found for your hall." style="-fx-text-fill: #64748b; -fx-font-size: 13px;" />
                            </placeholder>
                        </TableView>
                    </VBox>

                </VBox>
            </ScrollPane>

            <HBox styleClass="status-strip">
                <Label text="●" styleClass="status-dot-active" />
                <Label styleClass="status-strip-text" text="Grievance Resolution Desk Synchronized · Live DB Connected" />
            </HBox>

            <HBox styleClass="university-footer">
                <Label styleClass="university-footer-text" text="Rajshahi University of Engineering &amp; Technology · Hall Management System · Automated Hall ERP" />
            </HBox>

        </VBox>
    </center>

</BorderPane>
