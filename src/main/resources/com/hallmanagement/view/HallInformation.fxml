<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hallmanagement.controller.HallInformationController"
            styleClass="dashboard-root"
            stylesheets="@../css/dashboard.css"
            minWidth="1050" minHeight="720">

    <left>
        <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="250" spacing="0">
            <VBox styleClass="sidebar-header" spacing="4">
                <Label styleClass="sidebar-app-name" text="RUET Hall System" />
                <Label fx:id="lblPortalTitle" styleClass="sidebar-portal" text="STUDENT PORTAL" />
            </VBox>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-width: 0;" VBox.vgrow="ALWAYS">
                <VBox styleClass="sidebar-nav" spacing="3">
                    <Label styleClass="nav-section-label" text="MAIN NAVIGATION" />
                    <Button fx:id="btnNavDashboard" styleClass="nav-button" text="🏠  Dashboard" onAction="#onDashboardClicked" />
                    <Button fx:id="btnNavProfile"   styleClass="nav-button" text="👤  My Profile" onAction="#onMyProfileClicked" />
                    <Button fx:id="btnNavHallInfo"  styleClass="nav-button-active" text="🏢  Hall Information" />
                    <Button fx:id="btnNavBillingOrRequests" styleClass="nav-button" text="💳  Bill &amp; Due" onAction="#onBillingOrRequestsClicked" />
                    <Button fx:id="btnNavNoticeBoard" styleClass="nav-button" text="📢  Notice Board" onAction="#onNoticeBoardClicked" />

                    <Region prefHeight="10" />

                    <Label fx:id="lblNavSecondarySection" styleClass="nav-section-label" text="RESIDENCE SERVICES" />
                    <VBox fx:id="boxSecondaryNavStudent" spacing="2">
                        <Button fx:id="btnNavStudentHallChange" styleClass="nav-button" text="🔄  Apply for New Hall" onAction="#onHallChangeClicked" />
                        <Button fx:id="btnNavStudentRoomChange" styleClass="nav-button" text="🛏  Room/Seat Change" onAction="#onRoomChangeClicked" />
                        <Button fx:id="btnNavStudentComplaints" styleClass="nav-button" text="📝  Complaints" onAction="#onComplaintsClicked" />
                        <Button fx:id="btnNavStudentHallLeave"  styleClass="nav-button" text="🚪  Hall Leave" onAction="#onHallLeaveClicked" />
                    </VBox>
                    <VBox fx:id="boxSecondaryNavProvost" spacing="2" managed="false" visible="false">
                        <Button fx:id="btnNavHallChangeRequests" styleClass="nav-button" text="🔄  Hall Change Requests" onAction="#onHallChangeRequestsClicked" />
                        <Button fx:id="btnNavRoomChangeRequests" styleClass="nav-button" text="🛏  Room/Seat Change Requests" onAction="#onRoomChangeRequestsClicked" />
                        <Button fx:id="btnNavComplaints" styleClass="nav-button" text="📝  Complaints" onAction="#onComplaintsClicked" />
                        <Button fx:id="btnNavHallLeaveRequests" styleClass="nav-button" text="🚪  Hall Leave Requests" onAction="#onHallLeaveRequestsClicked" />
                    </VBox>
                </VBox>
            </ScrollPane>

            <VBox styleClass="sidebar-footer" alignment="BOTTOM_CENTER">
                <Label fx:id="lblUserId" styleClass="sidebar-footer-text" />
                <Label fx:id="lblRole"   styleClass="sidebar-footer-text" />
                <Region prefHeight="6" />
                <Button fx:id="btnLogout"
                        styleClass="btn-logout"
                        text="⏻  Sign Out"
                        maxWidth="Infinity"
                        onAction="#onLogoutClicked" />
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="0" VBox.vgrow="ALWAYS">

            <HBox styleClass="top-header-bar">
                <Button fx:id="btnBack" text="← Back" styleClass="btn-top-back" onAction="#onBackClicked" />
                <Label fx:id="lblBreadcrumb" styleClass="top-header-title" text="RUET Residential Halls  ›  Digital Infrastructure Profile" HBox.hgrow="ALWAYS" maxWidth="Infinity" />

                <Label text="Select Hall:" styleClass="field-label" />
                <ComboBox fx:id="cmbSelectHall" prefWidth="260" styleClass="combo-field" onAction="#onHallSelected" />

                <Button fx:id="btnRefresh" text="🔄 Refresh" styleClass="btn-ghost" onAction="#onRefreshClicked" />
            </HBox>

            <ScrollPane fitToWidth="true" fitToHeight="false" styleClass="main-scroll" VBox.vgrow="ALWAYS">
                <VBox styleClass="main-content-fluid" spacing="18">

                    <VBox styleClass="content-card" spacing="8">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="RUET RESIDENTIAL HALLS (CLICK TO SWITCH HALL PROFILE):" styleClass="section-title" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label text="Your residence is listed 1st, followed by other halls" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-font-style: italic;" />
                        </HBox>
                        <ScrollPane fitToHeight="true" vbarPolicy="NEVER" hbarPolicy="AS_NEEDED" styleClass="tab-scroll-bar">
                            <HBox fx:id="boxHallCardsSerial" spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 4 2 8 2;">

                            </HBox>
                        </ScrollPane>
                    </VBox>

                    <HBox styleClass="residence-banner" alignment="CENTER_LEFT" spacing="20">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label fx:id="lblHallNameHeader" styleClass="residence-banner-title" text="Shahid Shahidul Islam Hall" />
                                <Label fx:id="lblHallTypeBadge" style="-fx-background-color: rgba(59,130,246,0.2); -fx-text-fill: #93c5fd; -fx-padding: 3 10; -fx-background-radius: 12; -fx-font-weight: bold; -fx-font-size: 11px;" text="MALE RESIDENCE" />
                            </HBox>
                            <Label fx:id="lblHallProvostSummary" styleClass="residence-banner-details" text="Provost: Prof. Dr. M. Rahman | Office: Ground Floor | Established: 1964" />
                        </VBox>
                        <VBox alignment="CENTER_RIGHT" spacing="4" minWidth="200">
                            <Label text="LIVE OCCUPANCY RATE" style="-fx-font-size: 10px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;" />
                            <ProgressBar fx:id="progressOccupancy" prefWidth="180" prefHeight="10" progress="0.75" style="-fx-accent: #10b981;" />
                            <Label fx:id="lblOccupancyPercent" style="-fx-font-size: 13px; -fx-text-fill: #34d399; -fx-font-weight: bold;" text="75.0% Occupied" />
                        </VBox>
                    </HBox>

                    <VBox styleClass="content-card" spacing="10">
                        <Label text="LIVE INFRASTRUCTURE &amp; OCCUPANCY METRICS" styleClass="section-title" />

                        <HBox styleClass="metrics-grid" spacing="10" alignment="CENTER">
                            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="3">
                                <Label styleClass="metric-label" text="🏢 FLOORS" />
                                <Label fx:id="lblKpiFloors" styleClass="metric-value" text="0" />
                            </VBox>
                            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="3">
                                <Label styleClass="metric-label" text="🚪 TOTAL ROOMS" />
                                <Label fx:id="lblKpiRooms" styleClass="metric-value" text="0" />
                            </VBox>
                            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="3">
                                <Label styleClass="metric-label" text="🛏 TOTAL SEATS" />
                                <Label fx:id="lblKpiSeats" styleClass="metric-value" text="0" />
                            </VBox>
                            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="3">
                                <Label styleClass="metric-label" text="👨‍🎓 OCCUPIED" />
                                <Label fx:id="lblKpiOccupied" styleClass="metric-value-occupied" text="0" />
                            </VBox>
                            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="3">
                                <Label styleClass="metric-label" text="🟢 VACANT" />
                                <Label fx:id="lblKpiVacant" styleClass="metric-value-available" text="0" />
                            </VBox>
                            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="3">
                                <Label styleClass="metric-label" text="👥 TOTAL STAFF" />
                                <Label fx:id="lblKpiStaff" styleClass="metric-value" text="0" />
                            </VBox>
                        </HBox>

                        <HBox styleClass="metrics-grid" spacing="10" alignment="CENTER">
                            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="3">
                                <Label styleClass="metric-label" text="❄️ TOTAL AC" />
                                <Label fx:id="lblKpiAc" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #38bdf8;" text="0" />
                            </VBox>
                            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="3">
                                <Label styleClass="metric-label" text="🌀 TOTAL FANS" />
                                <Label fx:id="lblKpiFans" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #4ade80;" text="0" />
                            </VBox>
                            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="3">
                                <Label styleClass="metric-label" text="💡 TOTAL LIGHTS" />
                                <Label fx:id="lblKpiLights" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #fbbf24;" text="0" />
                            </VBox>
                            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="3">
                                <Label styleClass="metric-label" text="🚿 WASHROOMS" />
                                <Label fx:id="lblKpiWashrooms" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #c084fc;" text="0" />
                            </VBox>
                            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="3">
                                <Label styleClass="metric-label" text="📹 CCTV CAMERAS" />
                                <Label fx:id="lblKpiCctv" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #fb923c;" text="0" />
                            </VBox>
                            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="3">
                                <Label styleClass="metric-label" text="🔥 FIRE SAFETY" />
                                <Label fx:id="lblKpiFireSafety" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #f87171;" text="0" />
                            </VBox>
                            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="3">
                                <Label styleClass="metric-label" text="🔧 PENDING REPAIRS" />
                                <Label fx:id="lblKpiMaintenance" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #facc15;" text="0" />
                            </VBox>
                        </HBox>
                    </VBox>

                    <Label fx:id="lblFeedback" styleClass="feedback-label" text="" managed="false" visible="false" />

                    <VBox spacing="10">
                        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="tab-nav-container">
                            <Button fx:id="btnTabScrollLeft" text="◀" styleClass="btn-tab-scroll" onAction="#onTabScrollLeft" />

                            <ScrollPane fx:id="scrollTabBar" fitToHeight="true" vbarPolicy="NEVER" hbarPolicy="AS_NEEDED" styleClass="tab-scroll-bar" HBox.hgrow="ALWAYS">
                                <HBox fx:id="boxTabButtons" spacing="8" alignment="CENTER_LEFT" style="-fx-padding: 4 4 8 4;">
                                    <Button fx:id="tabBtnOverview" text="🏢  Overview" styleClass="tab-pill-active" onAction="#onTabOverviewClicked" />
                                    <Button fx:id="tabBtnBuilding" text="🏛️  Building &amp; Facilities" styleClass="tab-pill" onAction="#onTabBuildingClicked" />
                                    <Button fx:id="tabBtnFloors" text="🪜  Floor Management" styleClass="tab-pill" onAction="#onTabFloorsClicked" />
                                    <Button fx:id="tabBtnRooms" text="🚪  Rooms &amp; Occupancy" styleClass="tab-pill" onAction="#onTabRoomsClicked" />
                                    <Button fx:id="tabBtnElectrical" text="⚡  Electrical System" styleClass="tab-pill" onAction="#onTabElectricalClicked" />
                                    <Button fx:id="tabBtnFurniture" text="🪑  Furniture" styleClass="tab-pill" onAction="#onTabFurnitureClicked" />
                                    <Button fx:id="tabBtnAc" text="❄️  AC &amp; Cooling" styleClass="tab-pill" onAction="#onTabAcClicked" />
                                    <Button fx:id="tabBtnLighting" text="💡  Lighting" styleClass="tab-pill" onAction="#onTabLightingClicked" />
                                    <Button fx:id="tabBtnWashrooms" text="🚿  Washrooms" styleClass="tab-pill" onAction="#onTabWashroomsClicked" />
                                    <Button fx:id="tabBtnWater" text="💧  Water System" styleClass="tab-pill" onAction="#onTabWaterClicked" />
                                    <Button fx:id="tabBtnDining" text="🍽️  Kitchen &amp; Dining" styleClass="tab-pill" onAction="#onTabDiningClicked" />
                                    <Button fx:id="tabBtnNetwork" text="🌐  Network" styleClass="tab-pill" onAction="#onTabNetworkClicked" />
                                    <Button fx:id="tabBtnCctv" text="📹  CCTV &amp; Security" styleClass="tab-pill" onAction="#onTabCctvClicked" />
                                    <Button fx:id="tabBtnFire" text="🧯  Fire Safety" styleClass="tab-pill" onAction="#onTabFireClicked" />
                                    <Button fx:id="tabBtnMaintenance" text="🔧  Maintenance" styleClass="tab-pill" onAction="#onTabMaintenanceClicked" />
                                    <Button fx:id="tabBtnCleaning" text="🧹  Cleaning" styleClass="tab-pill" onAction="#onTabCleaningClicked" />
                                    <Button fx:id="tabBtnContacts" text="📞  Contact Directory" styleClass="tab-pill" onAction="#onTabContactsClicked" />
                                    <Button fx:id="tabBtnUtilities" text="💰  Utilities &amp; Expenses" styleClass="tab-pill" onAction="#onTabUtilitiesClicked" />
                                    <Button fx:id="tabBtnAssets" text="📦  Asset Inventory" styleClass="tab-pill" onAction="#onTabAssetsClicked" />
                                </HBox>
                            </ScrollPane>

                            <Button fx:id="btnTabScrollRight" text="▶" styleClass="btn-tab-scroll" onAction="#onTabScrollRight" />
                        </HBox>

                        <StackPane fx:id="tabContentStack" VBox.vgrow="ALWAYS">

                            <VBox fx:id="paneOverview" spacing="16" style="-fx-padding: 8 0 0 0;">
                                <HBox spacing="16">

                                    <VBox styleClass="content-card" HBox.hgrow="ALWAYS" spacing="12">
                                        <Label text="INSTITUTIONAL PROFILE" styleClass="section-title" />
                                        <GridPane hgap="16" vgap="10">
                                            <Label text="Hall Name:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                            <Label fx:id="lblOverviewName" style="-fx-text-fill: #ffffff; -fx-font-weight: 600;" text="—" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                            <Label text="Hall Code / ID:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                            <Label fx:id="lblOverviewCode" style="-fx-text-fill: #38bdf8; -fx-font-weight: 700;" text="—" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                            <Label text="Established Year:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                            <Label fx:id="lblOverviewEst" style="-fx-text-fill: #ffffff;" text="—" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                            <Label text="Campus Address:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                            <Label fx:id="lblOverviewAddress" style="-fx-text-fill: #ffffff;" text="—" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                            <Label text="Residential Students:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                            <Label fx:id="lblOverviewResStudents" style="-fx-text-fill: #4ade80; -fx-font-weight: bold;" text="—" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                                            <Label text="Non-Residential Students:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                                            <Label fx:id="lblOverviewNonResStudents" style="-fx-text-fill: #ffffff;" text="—" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                                        </GridPane>
                                    </VBox>

                                    <VBox styleClass="content-card" HBox.hgrow="ALWAYS" spacing="12">
                                        <Label text="ADMINISTRATION &amp; CONTACTS" styleClass="section-title" />
                                        <GridPane hgap="16" vgap="10">
                                            <Label text="Provost:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                            <Label fx:id="lblOverviewProvost" style="-fx-text-fill: #38bdf8; -fx-font-weight: 600;" text="—" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                            <Label text="Assistant Provosts:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                            <Label fx:id="lblOverviewAsstProvost" style="-fx-text-fill: #ffffff;" text="—" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                            <Label text="Hall Office Contact:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                            <Label fx:id="lblOverviewOfficePhone" style="-fx-text-fill: #ffffff;" text="—" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                            <Label text="Emergency Hotline:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                            <Label fx:id="lblOverviewEmergencyPhone" style="-fx-text-fill: #f87171; -fx-font-weight: bold;" text="—" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                            <Label text="Hall Official Email:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                            <Label fx:id="lblOverviewEmail" style="-fx-text-fill: #ffffff;" text="—" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                                            <Label text="Operational Staff:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                                            <Label fx:id="lblOverviewStaffCount" style="-fx-text-fill: #ffffff;" text="—" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                                        </GridPane>
                                    </VBox>
                                </HBox>

                                <VBox styleClass="content-card" spacing="8">
                                    <Label text="ABOUT THIS RESIDENTIAL HALL" styleClass="section-title" />
                                    <Label fx:id="lblOverviewDesc" style="-fx-text-fill: #cbd5e1; -fx-font-size: 13px; -fx-line-spacing: 4;" text="Loading description..." wrapText="true" />
                                </VBox>
                            </VBox>

                            <VBox fx:id="paneBuilding" spacing="16" style="-fx-padding: 8 0 0 0;" visible="false" managed="false">
                                <VBox styleClass="content-card" spacing="14">
                                    <Label text="BUILDING SPECIFICATIONS &amp; FACILITY DISTRIBUTION" styleClass="section-title" />
                                    <FlowPane fx:id="flowBuildingSpecs" hgap="16" vgap="14">

                                    </FlowPane>
                                </VBox>
                            </VBox>

                            <VBox fx:id="paneFloors" spacing="16" style="-fx-padding: 8 0 0 0;" visible="false" managed="false">
                                <VBox styleClass="content-card" spacing="12">
                                    <Label text="FLOOR-BY-FLOOR METRICS &amp; CAPACITIES" styleClass="section-title" />
                                    <TableView fx:id="tableFloors" styleClass="history-table" prefHeight="380">
                                        <columns>
                                            <TableColumn fx:id="colFloorNum" text="Floor" minWidth="90" prefWidth="100" style="-fx-alignment: CENTER;" />
                                            <TableColumn fx:id="colFloorRooms" text="Rooms" minWidth="80" prefWidth="90" style="-fx-alignment: CENTER;" />
                                            <TableColumn fx:id="colFloorSeats" text="Total Seats" minWidth="90" prefWidth="100" style="-fx-alignment: CENTER;" />
                                            <TableColumn fx:id="colFloorOccupied" text="Occupied" minWidth="80" prefWidth="90" style="-fx-alignment: CENTER;" />
                                            <TableColumn fx:id="colFloorVacant" text="Vacant" minWidth="80" prefWidth="90" style="-fx-alignment: CENTER;" />
                                            <TableColumn fx:id="colFloorOccRate" text="Occupancy" minWidth="95" prefWidth="105" style="-fx-alignment: CENTER;" />
                                            <TableColumn fx:id="colFloorAc" text="AC" minWidth="65" prefWidth="75" style="-fx-alignment: CENTER;" />
                                            <TableColumn fx:id="colFloorFans" text="Fans" minWidth="75" prefWidth="85" style="-fx-alignment: CENTER;" />
                                            <TableColumn fx:id="colFloorLights" text="Lights" minWidth="75" prefWidth="85" style="-fx-alignment: CENTER;" />
                                            <TableColumn fx:id="colFloorWashrooms" text="Washrooms" minWidth="95" prefWidth="105" style="-fx-alignment: CENTER;" />
                                            <TableColumn fx:id="colFloorTaps" text="Taps" minWidth="75" prefWidth="85" style="-fx-alignment: CENTER;" />
                                            <TableColumn fx:id="colFloorExits" text="Exits" minWidth="65" prefWidth="75" style="-fx-alignment: CENTER;" />
                                            <TableColumn fx:id="colFloorAction" text="Action" minWidth="120" prefWidth="135" style="-fx-alignment: CENTER;" />
                                        </columns>
                                    </TableView>
                                </VBox>
                            </VBox>

                            <VBox fx:id="paneRooms" spacing="16" style="-fx-padding: 8 0 0 0;" visible="false" managed="false">
                                <VBox styleClass="content-card" spacing="12">
                                    <HBox alignment="CENTER_LEFT" spacing="14">
                                        <Label text="ROOM DIRECTORY &amp; LIVE OCCUPANCY" styleClass="section-title" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <TextField fx:id="txtSearchRoom" promptText="🔍  Search room number or type…" styleClass="search-input" prefWidth="250" onKeyReleased="#onRoomSearchChanged" />
                                        <Label text="Floor:" styleClass="field-label" />
                                        <ComboBox fx:id="cmbFloorFilter" prefWidth="140" styleClass="combo-filter" onAction="#onFloorFilterChanged" />
                                    </HBox>

                                    <TableView fx:id="tableRooms" styleClass="history-table" prefHeight="400">
                                        <columns>
                                            <TableColumn fx:id="colRoomNum" text="Room #" minWidth="80" prefWidth="90" style="-fx-alignment: CENTER;" />
                                            <TableColumn fx:id="colRoomFloor" text="Floor" minWidth="70" prefWidth="80" style="-fx-alignment: CENTER;" />
                                            <TableColumn fx:id="colRoomType" text="Room Type" minWidth="120" prefWidth="140" />
                                            <TableColumn fx:id="colRoomCapacity" text="Capacity" minWidth="80" prefWidth="90" style="-fx-alignment: CENTER;" />
                                            <TableColumn fx:id="colRoomOccupiedSeats" text="Occupied" minWidth="80" prefWidth="90" style="-fx-alignment: CENTER;" />
                                            <TableColumn fx:id="colRoomVacantSeats" text="Vacant" minWidth="80" prefWidth="90" style="-fx-alignment: CENTER;" />
                                            <TableColumn fx:id="colRoomStatus" text="Status" minWidth="110" prefWidth="130" style="-fx-alignment: CENTER;" />
                                            <TableColumn fx:id="colRoomAcCount" text="AC" minWidth="60" prefWidth="70" style="-fx-alignment: CENTER;" />
                                            <TableColumn fx:id="colRoomFansCount" text="Fans" minWidth="70" prefWidth="80" style="-fx-alignment: CENTER;" />
                                            <TableColumn fx:id="colRoomLightsCount" text="Lights" minWidth="70" prefWidth="80" style="-fx-alignment: CENTER;" />
                                            <TableColumn fx:id="colRoomCondition" text="Condition" minWidth="95" prefWidth="110" style="-fx-alignment: CENTER;" />
                                            <TableColumn fx:id="colRoomAction" text="Action" minWidth="130" prefWidth="150" style="-fx-alignment: CENTER;" />
                                        </columns>
                                    </TableView>
                                </VBox>
                            </VBox>

                            <VBox fx:id="paneElectrical" spacing="16" style="-fx-padding: 8 0 0 0;" visible="false" managed="false">
                                <HBox spacing="16">
                                    <VBox styleClass="content-card" HBox.hgrow="ALWAYS" spacing="12">
                                        <Label text="AUTOMATIC ELECTRICAL ROLLUP" styleClass="section-title" />
                                        <GridPane hgap="16" vgap="12">
