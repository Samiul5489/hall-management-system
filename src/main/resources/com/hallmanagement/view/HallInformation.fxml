                                            <TableColumn fx:id="colAssetPrice" text="Value (Tk)" minWidth="95" prefWidth="110" style="-fx-alignment: CENTER-RIGHT;" />
                                            <TableColumn fx:id="colAssetCondition" text="Condition" minWidth="95" prefWidth="110" style="-fx-alignment: CENTER;" />
                                            <TableColumn fx:id="colAssetWarranty" text="Warranty" minWidth="130" prefWidth="150" />
