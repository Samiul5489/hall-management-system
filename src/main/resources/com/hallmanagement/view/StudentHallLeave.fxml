<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hallmanagement.controller.StudentHallLeaveController"
            styleClass="dashboard-root"
            stylesheets="@../css/dashboard.css"
            minWidth="960" minHeight="640">

    <left>
        <VBox styleClass="sidebar" prefWidth="250" spacing="0">
            <VBox styleClass="sidebar-header" spacing="4">
                <Label styleClass="sidebar-app-name" text="RUET Hall System" />
                <Label styleClass="sidebar-portal"   text="STUDENT PORTAL" />
            </VBox>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-width: 0;" VBox.vgrow="ALWAYS">
                <VBox styleClass="sidebar-nav" spacing="3">
                    <Label styleClass="nav-section-label" text="MAIN NAVIGATION" />
                    <Button fx:id="btnNavDashboard" styleClass="nav-button" text="🏠  Dashboard" onAction="#onDashboardClicked" />
                    <Button fx:id="btnNavProfile"   styleClass="nav-button" text="👤  My Profile" onAction="#onProfileClicked" />
                    <Button fx:id="btnNavHallInfo"  styleClass="nav-button" text="🏢  Hall Information" onAction="#onHallInformationClicked" />
                    <Button fx:id="btnNavBilling"   styleClass="nav-button" text="💳  Bill &amp; Due" onAction="#onBillingClicked" />
                    <Button fx:id="btnNavNoticeBoard" styleClass="nav-button" text="📢  Notice Board" onAction="#onNoticeBoardClicked" />

                    <Region prefHeight="10" />

                    <Label styleClass="nav-section-label" text="RESIDENCE SERVICES" />
                    <Button fx:id="btnNavHallChange" styleClass="nav-button" text="🔄  Apply for New Hall" onAction="#onHallChangeClicked" />
                    <Button fx:id="btnNavRoomChange" styleClass="nav-button" text="🛏  Room/Seat Change" onAction="#onRoomChangeClicked" />
                    <Button fx:id="btnNavComplaints" styleClass="nav-button" text="📝  Complaints" onAction="#onComplaintsClicked" />
                    <Button fx:id="btnNavHallLeave"  styleClass="nav-button-active" text="🚪  Hall Leave" />
                </VBox>
            </ScrollPane>

            <VBox styleClass="sidebar-footer" alignment="BOTTOM_CENTER">
                <Label fx:id="lblSidebarUser" styleClass="sidebar-footer-text" />
                <Label fx:id="lblSidebarRole" styleClass="sidebar-footer-text" />
                <Region prefHeight="6" />
                <Button fx:id="btnLogout"
                        styleClass="btn-logout"
                        text="⏻  Sign Out"
                        maxWidth="Infinity"
                        onAction="#onLogoutClicked" />
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="0" VBox.vgrow="ALWAYS">

            <HBox styleClass="top-header-bar">
                <Button text="← Back" styleClass="btn-top-back" onAction="#onBackClicked" />
                <Label styleClass="top-header-title" text="Hall Leave &amp; Clearance Application" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="🔄 Refresh" styleClass="btn-ghost" onAction="#onRefreshClicked" />
            </HBox>

            <ScrollPane fitToWidth="true" fitToHeight="false" styleClass="main-scroll" VBox.vgrow="ALWAYS">
                <VBox styleClass="main-content-fluid" spacing="18">

                    <HBox styleClass="welcome-hero" alignment="CENTER_LEFT" spacing="18">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="SEAT VACATION &amp; CLEARANCE" styleClass="welcome-badge" />
                            <Label text="Apply for Official Hall Leave / Clearance" styleClass="welcome-name" />
                            <Label text="Request to officially vacate your hall seat upon graduation or clearance. Financial dues must be cleared (Tk. 0)." styleClass="welcome-meta" wrapText="true" />
                        </VBox>
                    </HBox>

                    <VBox styleClass="card" spacing="10">
                        <Label text="Current Assigned Seat Record" styleClass="card-title" />
                        <HBox spacing="24" alignment="CENTER_LEFT">
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label text="Current Hall:" styleClass="field-label" />
                                <Label fx:id="lblResHall" text="Loading..." styleClass="text-highlight" />
                            </VBox>
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label text="Current Room:" styleClass="field-label" />
                                <Label fx:id="lblResRoom" text="Loading..." styleClass="text-value-bold" />
                            </VBox>
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label text="Current Seat:" styleClass="field-label" />
                                <Label fx:id="lblResSeat" text="Loading..." styleClass="text-value-bold" />
                            </VBox>
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label text="Total Due:" styleClass="field-label" />
                                <Label fx:id="lblResDue" text="Tk. 0.00" styleClass="text-highlight-green" />
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox fx:id="boxEligibilityBanner" styleClass="card" spacing="10">
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <VBox spacing="3" HBox.hgrow="ALWAYS">
                                <Label fx:id="lblEligibilityTitle" text="Checking Eligibility..." styleClass="card-title" />
                                <Label fx:id="lblEligibilityMessage" text="" styleClass="text-muted" wrapText="true" />
                            </VBox>
                            <HBox fx:id="boxPendingActions" spacing="8" alignment="CENTER_RIGHT" visible="false" managed="false">
                                <Button fx:id="btnViewPendingDetails" text="👁 View Request" styleClass="btn-ghost" onAction="#onViewPendingDetailsClicked" />
                                <Button fx:id="btnCancelPendingRequest" text="❌ Cancel Request" styleClass="btn-danger" onAction="#onCancelPendingRequestClicked" />
                            </HBox>
                            <Button fx:id="btnOpenApplyForm" text="Apply for Hall Leave" styleClass="btn-primary" onAction="#onOpenApplyFormClicked" visible="false" managed="false" />
                            <Button fx:id="btnPayDueAction" text="Pay Dues in Bill &amp; Due →" styleClass="btn-primary" onAction="#onBillingClicked" visible="false" managed="false" />
                        </HBox>
                    </VBox>

                    <VBox fx:id="boxLeaveForm" styleClass="card" spacing="16" visible="false" managed="false">
                        <Label text="Submit Official Hall Leave Application" styleClass="card-title" />

                        <HBox styleClass="info-context-strip" spacing="16" alignment="CENTER_LEFT">
                            <Label text="Applicant:" styleClass="field-label" />
                            <Label fx:id="lblFormStudentName" styleClass="text-value-bold" text="Loading..." />
                            <Label text="•" styleClass="text-separator" />
                            <Label fx:id="lblFormStudentId" styleClass="text-highlight" text="" />
                            <Label text="•" styleClass="text-separator" />
                            <Label fx:id="lblFormStudentDept" styleClass="text-value" text="" />
                            <Label text="•" styleClass="text-separator" />
                            <Label fx:id="lblFormHall" styleClass="text-value" text="" />
                            <Label text="•" styleClass="text-separator" />
                            <Label fx:id="lblFormRoom" styleClass="text-value" text="" />
                            <Label text="•" styleClass="text-separator" />
                            <Label fx:id="lblFormSeat" styleClass="text-value" text="" />
                            <Label text="•" styleClass="text-separator" />
                            <Label fx:id="lblFormDue" styleClass="text-highlight-green" text="Tk. 0.00" />
                        </HBox>

                        <VBox spacing="4">
                            <Label text="Reason for Leaving Hall *:" styleClass="field-label" />
                            <TextArea fx:id="txtReason" promptText="Enter reasons (e.g. course completion, graduation, shifting to family residence)..." prefRowCount="3" wrapText="true" styleClass="text-area" />
                        </VBox>

                        <HBox alignment="CENTER_RIGHT" spacing="12">
                            <Label fx:id="lblFormFeedback" text="" styleClass="status-error" HBox.hgrow="ALWAYS" wrapText="true" />
                            <Button text="Cancel" styleClass="btn-ghost" onAction="#onCloseFormClicked" />
                            <Button fx:id="btnSubmitLeaveRequest" text="Submit Leave Application" styleClass="btn-primary" onAction="#onSubmitLeaveRequestClicked" />
                        </HBox>
                    </VBox>

                    <VBox fx:id="boxViewModal" styleClass="card" spacing="14" visible="false" managed="false">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label fx:id="lblModalTitle" text="Hall Leave Request Details" styleClass="card-title" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button text="✕ Close" styleClass="btn-ghost" onAction="#onCloseModalClicked" />
                        </HBox>

                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="Request Code:" styleClass="field-label" />
                            <Label fx:id="lblModalReqCode" styleClass="text-highlight" text="" />
                            <Label text="•" styleClass="text-separator" />
                            <Label text="Status:" styleClass="field-label" />
                            <Label fx:id="lblModalStatusBadge" text="" />
                            <Label text="•" styleClass="text-separator" />
                            <Label text="Date:" styleClass="field-label" />
                            <Label fx:id="lblModalReqDate" styleClass="text-value" text="" />
                        </HBox>

                        <HBox spacing="16" alignment="CENTER_LEFT">
                            <Label text="Hall:" styleClass="field-label" />
                            <Label fx:id="lblModalHall" styleClass="text-value" text="" />
                            <Label text="•" styleClass="text-separator" />
                            <Label text="Room / Seat:" styleClass="field-label" />
                            <Label fx:id="lblModalRoomSeat" styleClass="text-value" text="" />
                        </HBox>

                        <VBox spacing="4">
                            <Label text="Reason:" styleClass="field-label" />
                            <Label fx:id="lblModalReason" styleClass="text-value" text="" wrapText="true" />
                        </VBox>

                        <VBox fx:id="boxProvostDecision" spacing="4" visible="false" managed="false" styleClass="form-subcard-highlight">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Processed By:" styleClass="field-label" />
                                <Label fx:id="lblModalProcessedBy" styleClass="text-value" text="" />
                                <Label text="•" styleClass="text-separator" />
                                <Label text="Processed Date:" styleClass="field-label" />
                                <Label fx:id="lblModalProcessedDate" styleClass="text-value" text="" />
                            </HBox>
                        </VBox>

                        <VBox fx:id="boxDeclineReason" spacing="4" visible="false" managed="false">
                            <Label text="Decline Reason:" styleClass="field-label" />
                            <Label fx:id="lblModalDeclineReason" style="-fx-text-fill: #f87171;" text="" wrapText="true" />
                        </VBox>

                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Button fx:id="btnModalCancelRequest" text="Cancel Request" styleClass="btn-danger" onAction="#onCancelPendingRequestClicked" visible="false" managed="false" />
                        </HBox>
                    </VBox>

                    <VBox styleClass="card" spacing="12" VBox.vgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Your Hall Leave &amp; Clearance History" styleClass="card-title" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblHistoryCount" text="0 total requests" style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;" />
                        </HBox>

                        <TableView fx:id="tableLeaveHistory" minHeight="240">
                            <columns>
                                <TableColumn fx:id="colSerial" text="Serial" minWidth="60" prefWidth="65" style="-fx-alignment: CENTER;" />
                                <TableColumn fx:id="colDate" text="Date Applied" minWidth="110" prefWidth="125" style="-fx-alignment: CENTER;" />
                                <TableColumn fx:id="colHall" text="Hall" minWidth="140" prefWidth="170" />
                                <TableColumn fx:id="colRoom" text="Room" minWidth="90" prefWidth="100" style="-fx-alignment: CENTER;" />
                                <TableColumn fx:id="colSeat" text="Seat" minWidth="90" prefWidth="100" style="-fx-alignment: CENTER;" />
                                <TableColumn fx:id="colStatus" text="Status" minWidth="110" prefWidth="125" style="-fx-alignment: CENTER;" />
                                <TableColumn fx:id="colAction" text="Actions" minWidth="120" prefWidth="140" style="-fx-alignment: CENTER;" />
                            </columns>
                            <placeholder>
                                <Label text="No hall leave applications submitted yet." style="-fx-text-fill: #64748b; -fx-font-size: 13px;" />
                            </placeholder>
                        </TableView>
                    </VBox>

                </VBox>
            </ScrollPane>

            <HBox styleClass="status-strip">
                <Label text="●" styleClass="status-dot-active" />
                <Label styleClass="status-strip-text" text="Clearance Records Synchronized · Live DB Connected" />
            </HBox>

            <HBox styleClass="university-footer">
                <Label styleClass="university-footer-text" text="Rajshahi University of Engineering &amp; Technology · Hall Management System · Automated Hall ERP" />
            </HBox>

        </VBox>
    </center>

</BorderPane>
