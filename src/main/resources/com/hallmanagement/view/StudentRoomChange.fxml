<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hallmanagement.controller.StudentRoomChangeController"
            styleClass="dashboard-root"
            stylesheets="@../css/dashboard.css"
            minWidth="960" minHeight="640">

    <left>
        <VBox styleClass="sidebar" prefWidth="250" spacing="0">
            <VBox styleClass="sidebar-header" spacing="4">
                <Label styleClass="sidebar-app-name" text="RUET Hall System" />
                <Label styleClass="sidebar-portal"   text="STUDENT PORTAL" />
            </VBox>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-width: 0;" VBox.vgrow="ALWAYS">
                <VBox styleClass="sidebar-nav" spacing="3">
                    <Label styleClass="nav-section-label" text="MAIN NAVIGATION" />
                    <Button styleClass="nav-button" text="🏠  Dashboard" onAction="#onDashboardClicked" />
                    <Button styleClass="nav-button" text="👤  My Profile" onAction="#onProfileClicked" />
                    <Button styleClass="nav-button" text="🏢  Hall Information" onAction="#onHallInformationClicked" />
                    <Button fx:id="btnNavBilling" styleClass="nav-button" text="💳  Bill &amp; Due" onAction="#onBillingClicked" />
                    <Button fx:id="btnNavNoticeBoard" styleClass="nav-button" text="📢  Notice Board" onAction="#onNoticeBoardClicked" />

                    <Region prefHeight="10" />

                    <Label styleClass="nav-section-label" text="RESIDENCE SERVICES" />
                    <Button fx:id="btnNavHallChange" styleClass="nav-button" text="🔄  Apply for New Hall" onAction="#onHallChangeClicked" />
                    <Button fx:id="btnNavRoomChange" styleClass="nav-button-active" text="🛏  Room/Seat Change" />
                    <Button fx:id="btnNavComplaints" styleClass="nav-button" text="📝  Complaints" onAction="#onComplaintsClicked" />
                    <Button fx:id="btnNavHallLeave" styleClass="nav-button" text="🚪  Hall Leave" onAction="#onHallLeaveClicked" />
                </VBox>
            </ScrollPane>

            <VBox styleClass="sidebar-footer" alignment="BOTTOM_CENTER">
                <Label fx:id="lblSidebarUser" styleClass="sidebar-footer-text" />
                <Label fx:id="lblSidebarRole" styleClass="sidebar-footer-text" />
                <Region prefHeight="6" />
                <Button fx:id="btnLogout"
                        styleClass="btn-logout"
                        text="⏻  Sign Out"
                        maxWidth="Infinity"
                        onAction="#onLogoutClicked" />
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="0" VBox.vgrow="ALWAYS">

            <HBox styleClass="top-header-bar">
                <Button text="← Back" styleClass="btn-top-back" onAction="#onBackClicked" />
                <Label styleClass="top-header-title" text="Room &amp; Seat Change Application" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="🔄 Refresh" styleClass="btn-ghost" onAction="#onRefreshClicked" />
            </HBox>

            <ScrollPane fitToWidth="true" fitToHeight="false" styleClass="main-scroll" VBox.vgrow="ALWAYS">
                <VBox styleClass="main-content-fluid" spacing="18">

                    <HBox styleClass="welcome-hero" alignment="CENTER_LEFT" spacing="18">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="SAME-HALL RESIDENCE SERVICES" styleClass="welcome-badge" />
                            <Label text="Room / Seat Change Request" styleClass="welcome-name" />
                            <Label text="Request to switch to a different room or seat within your currently assigned hall. Dues must be cleared." styleClass="welcome-meta" wrapText="true" />
                        </VBox>
                    </HBox>

                    <VBox styleClass="card" spacing="10">
                        <Label text="Current Assigned Residence" styleClass="card-title" />
                        <HBox spacing="24" alignment="CENTER_LEFT">
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label text="Current Hall:" styleClass="field-label" />
                                <Label fx:id="lblCurrentHall" text="Loading..." styleClass="text-highlight" />
                            </VBox>
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label text="Current Room:" styleClass="field-label" />
                                <Label fx:id="lblCurrentRoom" text="Loading..." styleClass="text-value-bold" />
                            </VBox>
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label text="Current Seat:" styleClass="field-label" />
                                <Label fx:id="lblCurrentSeat" text="Loading..." styleClass="text-value-bold" />
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox fx:id="boxEligibilityBanner" styleClass="card" spacing="10">
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <VBox spacing="3" HBox.hgrow="ALWAYS">
                                <Label fx:id="lblEligibilityTitle" text="Checking Eligibility..." styleClass="card-title" />
                                <Label fx:id="lblEligibilityMessage" text="" styleClass="text-muted" wrapText="true" />
                            </VBox>
                            <Button fx:id="btnPayDueAction" text="Pay Dues in Bill &amp; Due →" styleClass="btn-primary" onAction="#onBillingClicked" visible="false" managed="false" />
                        </HBox>
                    </VBox>

                    <VBox fx:id="boxPendingNotice" styleClass="card" spacing="12" visible="false" managed="false">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <VBox spacing="3" HBox.hgrow="ALWAYS">
                                <Label text="Pending Room Change Request" styleClass="card-title" />
                                <Label fx:id="lblPendingNoticeSummary" text="" styleClass="text-highlight-amber" wrapText="true" />
                            </VBox>
                            <HBox spacing="8" alignment="CENTER_RIGHT">
                                <Button text="✏ Edit Request" styleClass="btn-ghost" onAction="#onEditPendingClicked" />
                                <Button text="❌ Cancel Request" styleClass="btn-danger" onAction="#onCancelPendingClicked" />
                            </HBox>
                        </HBox>
                    </VBox>

                    <VBox fx:id="boxApplicationForm" styleClass="card" spacing="16" visible="false" managed="false">
                        <Label fx:id="lblFormTitle" text="Submit New Room/Seat Change Request" styleClass="card-title" />

                        <HBox styleClass="info-context-strip" spacing="16" alignment="CENTER_LEFT">
                            <Label text="Applicant:" styleClass="field-label" />
                            <Label fx:id="lblFormStudentName" styleClass="text-value-bold" text="" />
                            <Label text="•" styleClass="text-separator" />
                            <Label fx:id="lblFormStudentId" styleClass="text-highlight" text="" />
                            <Label text="•" styleClass="text-separator" />
                            <Label fx:id="lblFormStudentDept" styleClass="text-value" text="" />
                            <Label text="•" styleClass="text-separator" />
                            <Label fx:id="lblFormCurrentHall" styleClass="text-highlight" text="" />
                        </HBox>

                        <GridPane hgap="20" vgap="14">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50" />
                                <ColumnConstraints percentWidth="50" />
                            </columnConstraints>

                            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Desired Target Room *:" styleClass="field-label" />
                                <ComboBox fx:id="cmbRequestedRoom" promptText="-- Select Available Room --" maxWidth="Infinity" styleClass="combo-field" />
                                <Label fx:id="lblRoomInfoSubtext" text="" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;" />
                            </VBox>

                            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Desired Target Seat *:" styleClass="field-label" />
                                <ComboBox fx:id="cmbRequestedSeat" promptText="-- Select Seat --" maxWidth="Infinity" styleClass="combo-field" />
                                <Label fx:id="lblSeatInfoSubtext" text="" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;" />
                            </VBox>

                            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                                <Label text="Reason for Change Request *:" styleClass="field-label" />
                                <TextArea fx:id="txtReason" promptText="Provide specific reasons (e.g. academic group study, noise issues, health reasons)..." prefRowCount="3" wrapText="true" styleClass="text-area" />
                            </VBox>
                        </GridPane>

                        <HBox alignment="CENTER_RIGHT" spacing="12">
                            <Label fx:id="lblFormFeedback" text="" styleClass="status-error" HBox.hgrow="ALWAYS" wrapText="true" />
                            <Button fx:id="btnCancelForm" text="Cancel" styleClass="btn-ghost" onAction="#onCancelFormClicked" visible="false" managed="false" />
                            <Button fx:id="btnSubmitRequest" text="Submit Application" styleClass="btn-primary" onAction="#onSubmitRequestClicked" />
                        </HBox>
                    </VBox>

                    <VBox fx:id="boxReviewModal" styleClass="card" spacing="14" visible="false" managed="false">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Room Change Request Details" styleClass="card-title" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button text="✕ Close" styleClass="btn-ghost" onAction="#onCloseReviewModalClicked" />
                        </HBox>

                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="Request Code:" styleClass="field-label" />
                            <Label fx:id="lblModalReqCode" styleClass="text-highlight" text="" />
                            <Label text="•" styleClass="text-separator" />
                            <Label text="Status:" styleClass="field-label" />
                            <Label fx:id="lblModalStatus" text="" />
                            <Label text="•" styleClass="text-separator" />
                            <Label text="Date:" styleClass="field-label" />
                            <Label fx:id="lblModalReqDate" styleClass="text-value" text="" />
                        </HBox>

                        <GridPane hgap="16" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints minWidth="140" />
                                <ColumnConstraints hgrow="ALWAYS" />
                            </columnConstraints>
                            <Label text="Current Residence:" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                            <Label fx:id="lblModalCurResidence" styleClass="text-value" text="" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                            <Label text="Requested Residence:" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                            <Label fx:id="lblModalReqResidence" styleClass="text-highlight" text="" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                            <Label text="Reason:" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                            <Label fx:id="lblModalReason" styleClass="text-value" text="" wrapText="true" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                        </GridPane>

                        <VBox fx:id="boxModalProcessedInfo" spacing="4" visible="false" managed="false">
                            <HBox spacing="10">
                                <Label text="Processed By:" styleClass="field-label" />
                                <Label fx:id="lblModalProcessedBy" styleClass="text-value" text="" />
                                <Label text="•" styleClass="text-separator" />
                                <Label text="Processed Date:" styleClass="field-label" />
                                <Label fx:id="lblModalProcessedDate" styleClass="text-value" text="" />
                            </HBox>
                        </VBox>

                        <VBox fx:id="boxModalRejectionReason" spacing="4" visible="false" managed="false">
                            <Label text="Provost Note / Rejection Reason:" styleClass="field-label" />
                            <Label fx:id="lblModalRejectionReason" style="-fx-text-fill: #f87171;" text="" wrapText="true" />
                        </VBox>
                    </VBox>

                    <VBox styleClass="card" spacing="12" VBox.vgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Your Room Change Request History" styleClass="card-title" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblHistoryCount" text="0 total requests" style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;" />
                        </HBox>

                        <TableView fx:id="tableRequests" minHeight="240">
                            <columns>
                                <TableColumn fx:id="colSerial" text="Serial" minWidth="60" prefWidth="65" style="-fx-alignment: CENTER;" />
                                <TableColumn fx:id="colDate" text="Date Submitted" minWidth="110" prefWidth="120" style="-fx-alignment: CENTER;" />
                                <TableColumn fx:id="colCurRoom" text="Current Room" minWidth="110" prefWidth="120" style="-fx-alignment: CENTER;" />
                                <TableColumn fx:id="colCurSeat" text="Current Seat" minWidth="100" prefWidth="110" style="-fx-alignment: CENTER;" />
                                <TableColumn fx:id="colReqRoom" text="Target Room" minWidth="110" prefWidth="120" style="-fx-alignment: CENTER;" />
                                <TableColumn fx:id="colReqSeat" text="Target Seat" minWidth="100" prefWidth="110" style="-fx-alignment: CENTER;" />
                                <TableColumn fx:id="colReason" text="Reason" minWidth="160" prefWidth="200" />
                                <TableColumn fx:id="colStatus" text="Status" minWidth="100" prefWidth="115" style="-fx-alignment: CENTER;" />
                                <TableColumn fx:id="colAction" text="Actions" minWidth="110" prefWidth="120" style="-fx-alignment: CENTER;" />
                            </columns>
                            <placeholder>
                                <Label text="No room change requests recorded yet." style="-fx-text-fill: #64748b; -fx-font-size: 13px;" />
                            </placeholder>
                        </TableView>
                    </VBox>

                </VBox>
            </ScrollPane>

            <HBox styleClass="status-strip">
                <Label text="●" styleClass="status-dot-active" />
                <Label styleClass="status-strip-text" text="Room Change Service Synchronized · Live DB Connected" />
            </HBox>

            <HBox styleClass="university-footer">
                <Label styleClass="university-footer-text" text="Rajshahi University of Engineering &amp; Technology · Hall Management System · Automated Hall ERP" />
            </HBox>

        </VBox>
    </center>

</BorderPane>
