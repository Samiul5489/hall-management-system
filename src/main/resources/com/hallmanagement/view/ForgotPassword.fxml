<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.hallmanagement.controller.ForgotPasswordController"
           styleClass="root-pane"
           stylesheets="@../css/login.css"
           minWidth="960" minHeight="640">

    <VBox styleClass="bg-overlay" alignment="CENTER" spacing="16">

        <VBox alignment="CENTER" spacing="4" styleClass="app-header">
            <Label styleClass="app-title" text="UNIVERSITY HALL MANAGEMENT SYSTEM" />
            <Label styleClass="app-subtitle" text="Smart Hall Management &amp; Student Residence System" />
        </VBox>

        <VBox styleClass="login-card" alignment="TOP_CENTER" spacing="0" prefWidth="540">

            <HBox styleClass="card-header" alignment="CENTER_LEFT" spacing="14">
                <Button text="← Back to Login" styleClass="btn-top-back" onAction="#onBackToLoginClicked" />
                <Region HBox.hgrow="ALWAYS" />
                <Label styleClass="card-header-text" text="Password Recovery" />
                <Region HBox.hgrow="ALWAYS" />
                <Region prefWidth="90" />
            </HBox>

            <ScrollPane fitToWidth="true" fitToHeight="false" styleClass="card-scroll-pane" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER">
                <VBox styleClass="card-body" spacing="18" alignment="TOP_CENTER">
                    <padding><Insets top="20" right="32" bottom="30" left="32"/></padding>

                    <HBox styleClass="stepper-container" alignment="CENTER" spacing="8">
                        <HBox fx:id="stepPill1" styleClass="step-pill, step-pill-active" alignment="CENTER" spacing="6">
                            <Label fx:id="stepBadge1" text="1" styleClass="step-badge-num, step-badge-num-active" />
                            <Label fx:id="stepText1" text="Account ID" styleClass="step-pill-text, step-pill-text-active" />
                        </HBox>
                        <Label text="─" styleClass="step-separator" />
                        <HBox fx:id="stepPill2" styleClass="step-pill" alignment="CENTER" spacing="6">
                            <Label fx:id="stepBadge2" text="2" styleClass="step-badge-num" />
                            <Label fx:id="stepText2" text="Verify OTP" styleClass="step-pill-text" />
                        </HBox>
                        <Label text="─" styleClass="step-separator" />
                        <HBox fx:id="stepPill3" styleClass="step-pill" alignment="CENTER" spacing="6">
                            <Label fx:id="stepBadge3" text="3" styleClass="step-badge-num" />
                            <Label fx:id="stepText3" text="New Password" styleClass="step-pill-text" />
                        </HBox>
                    </HBox>

                    <VBox fx:id="boxStep1" spacing="16" maxWidth="480" alignment="CENTER_LEFT">
                        <VBox styleClass="info-callout" maxWidth="Infinity">
                            <Label text="Enter your Student Roll / Provost ID to receive a 6-digit verification code in your email." wrapText="true" styleClass="info-callout-text" />
                        </VBox>

                        <VBox spacing="6">
                            <Label text="Account Type" styleClass="field-label" />
                            <ComboBox fx:id="cmbRole" maxWidth="Infinity" styleClass="combo-field" promptText="Select Account Type" />
                        </VBox>

                        <VBox spacing="6">
                            <Label text="Student Roll / Provost ID" styleClass="field-label" />
                            <TextField fx:id="txtUserId" promptText="e.g. 2403058 or provost001" styleClass="input-field" maxWidth="Infinity" />
                        </VBox>

                        <Label fx:id="lblStatusStep1" styleClass="status-error" text="" wrapText="true" maxWidth="Infinity" visible="false" managed="false" />

                        <Button fx:id="btnSendOtp" text="SEND VERIFICATION CODE TO EMAIL" styleClass="btn-primary" maxWidth="Infinity" onAction="#onSendOtpClicked" />
                    </VBox>

                    <VBox fx:id="boxStep2" spacing="16" maxWidth="480" alignment="CENTER_LEFT" visible="false" managed="false">

                        <VBox spacing="4" styleClass="info-callout">
                            <Label fx:id="lblEmailNotice" text="A 6-digit verification code has been sent directly to your email inbox." wrapText="true" styleClass="info-callout-title" />
                            <Label text="Please check your email inbox (and spam folder) for the recovery code." styleClass="info-callout-text" wrapText="true" />
                        </VBox>

                        <VBox spacing="6">
                            <Label text="6-Digit Verification Code (OTP)" styleClass="field-label" />
                            <TextField fx:id="txtOtp" promptText="• • • • • •" styleClass="input-field" style="-fx-alignment: center; -fx-font-size: 18px; -fx-font-weight: bold; -fx-letter-spacing: 5;" maxWidth="Infinity" />
                        </VBox>

                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label fx:id="lblTimer" text="Code expires in: 3:00 min" styleClass="timer-label" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Hyperlink fx:id="linkResendOtp" text="Resend Code" styleClass="forgot-password" onAction="#onResendOtpClicked" />
                        </HBox>

                        <Label fx:id="lblStatusStep2" styleClass="status-error" text="" wrapText="true" maxWidth="Infinity" visible="false" managed="false" />

                        <Button fx:id="btnVerifyOtp" text="VERIFY CODE →" styleClass="btn-primary" maxWidth="Infinity" onAction="#onVerifyOtpClicked" />
                    </VBox>

                    <VBox fx:id="boxStep3" spacing="16" maxWidth="480" alignment="CENTER_LEFT" visible="false" managed="false">
                        <VBox spacing="4" styleClass="success-callout">
                            <Label text="✓ Identity Verified Successfully" styleClass="success-callout-title" />
                            <Label fx:id="lblVerifiedAccountInfo" text="Create a new secure password for your account." styleClass="success-callout-text" />
                        </VBox>

                        <VBox spacing="6">
                            <Label text="New Password" styleClass="field-label" />
                            <HBox alignment="CENTER_LEFT" styleClass="password-container">
                                <StackPane HBox.hgrow="ALWAYS">
                                    <PasswordField fx:id="txtNewPassword"
                                                   styleClass="password-input-field"
                                                   promptText="Enter new password (min. 4 characters)"
                                                   maxWidth="Infinity" />
                                    <TextField fx:id="txtNewPasswordPlain"
                                               styleClass="password-input-field"
                                               promptText="Enter new password (min. 4 characters)"
                                               maxWidth="Infinity"
                                               visible="false"
                                               managed="false" />
                                </StackPane>
                                <Button fx:id="btnToggleNewPassword"
                                        styleClass="btn-toggle-password"
                                        text="👁"
                                        onAction="#onToggleNewPasswordClicked"
                                        focusTraversable="false" />
                            </HBox>
                        </VBox>

                        <VBox spacing="6">
                            <Label text="Confirm New Password" styleClass="field-label" />
                            <HBox alignment="CENTER_LEFT" styleClass="password-container">
                                <StackPane HBox.hgrow="ALWAYS">
                                    <PasswordField fx:id="txtConfirmPassword"
                                                   styleClass="password-input-field"
                                                   promptText="Re-enter new password to confirm"
                                                   maxWidth="Infinity" />
                                    <TextField fx:id="txtConfirmPasswordPlain"
                                               styleClass="password-input-field"
                                               promptText="Re-enter new password to confirm"
                                               maxWidth="Infinity"
                                               visible="false"
                                               managed="false" />
                                </StackPane>
                                <Button fx:id="btnToggleConfirmPassword"
                                        styleClass="btn-toggle-password"
                                        text="👁"
                                        onAction="#onToggleConfirmPasswordClicked"
                                        focusTraversable="false" />
                            </HBox>
                        </VBox>

                        <Label fx:id="lblStatusStep3" styleClass="status-error" text="" wrapText="true" maxWidth="Infinity" visible="false" managed="false" />

                        <Button fx:id="btnResetPassword" text="UPDATE PASSWORD &amp; FINISH" styleClass="btn-primary" maxWidth="Infinity" onAction="#onResetPasswordClicked" />
                    </VBox>

                    <VBox fx:id="boxSuccess" spacing="16" maxWidth="480" alignment="CENTER" visible="false" managed="false" style="-fx-padding: 24 0;">
                        <Label text="✓ Password Reset Successful!" style="-fx-font-size: 17px; -fx-font-weight: 700; -fx-text-fill: #4ade80;" />
                        <Label text="Your account password has been updated in the database. You can now login with your User ID and new password." textAlignment="CENTER" wrapText="true" style="-fx-font-size: 12.5px; -fx-text-fill: #e2e8f0;" />

                        <Region prefHeight="8" />
                        <Button fx:id="btnLoginDirect" text="GO TO LOGIN" styleClass="btn-primary" prefWidth="220" onAction="#onBackToLoginClicked" />
                    </VBox>

                </VBox>
            </ScrollPane>

            <HBox styleClass="card-footer" alignment="CENTER">
                <Label styleClass="footer-text" text="Rajshahi University of Engineering &amp; Technology · Hall Management System · Automated Hall ERP" />
            </HBox>
        </VBox>
    </VBox>
</StackPane>
